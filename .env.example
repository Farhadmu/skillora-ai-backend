# ==============================================================================
# SKILLORA AI - BACKEND CONFIGURATION
# ==============================================================================
PORT=3001
NODE_ENV=production

# Security & Authentication (MUST be at least 32 characters cryptographic random strings)
JWT_SECRET=your_cryptographically_secure_32_byte_jwt_access_secret_here
JWT_REFRESH_SECRET=your_cryptographically_secure_32_byte_jwt_refresh_secret_here

# ==============================================================================
# MULTI-PROVIDER AI CASCADE
# Provide at least one key for live AI inference (Gemini, Groq, OpenRouter, etc.).
# If no provider is configured, endpoints requiring generative inference return
# a structured AI_PROVIDER_UNAVAILABLE error with truthful status reporting.
# ==============================================================================

# 1. Google Gemini (Free Tier: 15 Requests/Min, 1 Million Tokens/Min)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Groq Cloud (Free Ultra-Fast Tier: Llama 3.3 70B, Llama 3.1 8B, 30 RPM)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# 3. OpenRouter (Free Tier Models: gemini-2.0-flash-exp:free, llama-3.3-70b-instruct:free)
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE

# 4. Cohere (Trial Tier)
# Get key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=YOUR_COHERE_KEY_HERE

# 5. Mistral AI
# Get key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=YOUR_MISTRAL_KEY_HERE

# 6. Hugging Face Serverless Inference API
# Get token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=YOUR_HF_KEY_HERE

# 7. Ollama Local Node (Local offline LLM execution)
# Download at: https://ollama.ai (Run: ollama run llama3)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# PERSISTENCE & VECTOR STORES
# MongoDB is the sole primary source of truth for all persisted business entities.
# Qdrant provides vector storage for grounded retrieval-augmented generation.
# ==============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017/skillora
QDRANT_URL=http://localhost:6333
