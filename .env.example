# ==============================================================================
# SKILLORA AI - BACKEND CONFIGURATION
# ==============================================================================
PORT=3001
NODE_ENV=production

# Security & Authentication
JWT_SECRET=skillora_super_secret_access_key_2026
JWT_REFRESH_SECRET=skillora_super_secret_refresh_key_2026

# ==============================================================================
# MULTI-PROVIDER FREE AI CASCADE (8-TIER RESILIENCE)
# Any or all keys can be provided. If missing or rate-limited, the system
# automatically cascades down to free tiers and the built-in deterministic engine!
# ==============================================================================

# 1. Google Gemini (Free Tier: 15 Requests/Min, 1 Million Tokens/Min)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Groq Cloud (Free Ultra-Fast Tier: Llama 3.3 70B, Llama 3.1 8B, 30 RPM)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# 3. OpenRouter (Free Tier Models: gemini-2.0-flash-exp:free, llama-3.3-70b-instruct:free)
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE

# 4. Cohere (Free Trial Tier: Command-R, 1,000 free API calls/month)
# Get free trial key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=YOUR_COHERE_KEY_HERE

# 5. Mistral AI (Free Experimentation Tier)
# Get free key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=YOUR_MISTRAL_KEY_HERE

# 6. Hugging Face Serverless Inference API (Free Tier)
# Get free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=YOUR_HF_KEY_HERE

# 7. Ollama Local Node (100% Free, Unlimited Offline Execution)
# Download at: https://ollama.ai (Run: ollama run llama3)
OLLAMA_BASE_URL=http://localhost:11434

# 8. Skillora Deterministic Semantic Neural Engine
# Always ONLINE and BUILT-IN. Zero external API keys needed, 100% test pass guarantee.

# ==============================================================================
# DATA STORES (Zero-config embedded stores run automatically out of the box)
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017/skillora
QDRANT_URL=http://localhost:6333
